{
  "schemaVersion": 3,
  "name": "release-countdown",
  "version": "1.0.0",
  "runtime": "web-features-v1",
  "sdkCompatibility": "^0.4.0",
  "source": "src/index.tsx",
  "bundle": "app.js",
  "screens": [],
  "capabilities": [],
  "features": [
    {
      "id": "countdown",
      "label": "Release countdown",
      "export": "Countdown",
      "options": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "releaseDate": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "title",
          "releaseDate"
        ],
        "additionalProperties": false
      },
      "routes": [
        {
          "id": "root",
          "path": "/"
        }
      ]
    }
  ]
}
